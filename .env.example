NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

DISCORD_WEBHOOK_URL=
# Server-side fetch to /api (admin SSR loopback). Must match middleware bypass.
INTERNAL_API_KEY=

# Certificate issuance (app/api/certificates/review) — server-only, never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Auto-provided when "Protection Bypass for Automation" is enabled in Vercel (Deployment Protection).
# Required for adminFetch loopback on password-protected preview deployments.
VERCEL_AUTOMATION_BYPASS_SECRET=
NODE_ENV=